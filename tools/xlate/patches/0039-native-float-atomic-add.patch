+        // NX2NAVI: storage buffer binding seen as 32-bit floats: a second variable at the buffer's set and binding, for the
+        // atomic float add (Instructions.cs GenerateAtomicFloatAdd), which needs a pointer to the float it adds; SPIR-V
+        // cannot reinterpret the word pointers of the buffer's own variable. Both variables are marked Aliased. It is
+        // declared where the first atomic needs it, so only the shaders that add floats carry one.
+        public static SpvInstruction GetFloatStorageBuffer(CodeGenContext context, int binding)
+        {
+            if (context.FloatStorageBuffers.TryGetValue(binding, out SpvInstruction existing))
+            {
+                return existing;
+            }
+
+            BufferDefinition buffer = context.Properties.StorageBuffers[binding];
+
+            SpvInstruction arrayType = context.GetType(AggregateType.Array | AggregateType.FP32, 0);
+            SpvInstruction structType = context.TypeStruct(false, arrayType);
+
+            if (context.FloatStorageBuffers.Count == 0)
+            {
+                // The types are shared by every float view of the shader and decorated once, and so are the capability
+                // and the extension.
+                context.Decorate(arrayType, Decoration.ArrayStride, (LiteralInteger)4);
+                context.Decorate(structType, Decoration.BufferBlock);
+                context.MemberDecorate(structType, 0, Decoration.Offset, (LiteralInteger)0);
+
+                context.AddCapability(Capability.AtomicFloat32AddEXT);
+                context.AddExtension("SPV_EXT_shader_atomic_float_add");
+            }
+
+            SpvInstruction pointerType = context.TypePointer(StorageClass.Uniform, structType);
+            SpvInstruction variable = context.Variable(pointerType, StorageClass.Uniform);
+            int setIndex = context.TargetApi == TargetApi.Vulkan ? buffer.Set : 0;
+
+            context.Name(variable, buffer.Name + "_f32");
+            context.Decorate(variable, Decoration.DescriptorSet, (LiteralInteger)setIndex);
+            context.Decorate(variable, Decoration.Binding, (LiteralInteger)buffer.Binding);
+            context.Decorate(variable, Decoration.Aliased);
+            context.Decorate(context.StorageBuffers[binding], Decoration.Aliased);
+            context.AddGlobalVariable(variable);
+
+            context.FloatStorageBuffers.Add(binding, variable);
+
+            return variable;
+        }
